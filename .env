# Create .env file with content
@"
# Backend API Configuration
VITE_API_BASE_URL=http://localhost

# Service Ports
VITE_AUTH_PORT=3001
VITE_BANKING_PORT=3002
VITE_IWA_PORT=3003
VITE_GRIOT_PORT=3004
VITE_KINSHIP_PORT=3005
VITE_ESCROW_PORT=3006
VITE_DGA_PORT=3007
VITE_WTP_PORT=3030
VITE_MOOT_PORT=3008

# App Configuration
VITE_APP_NAME=Viewdicon
VITE_APP_VERSION=1.0.0

# Feature Flags
VITE_ENABLE_BIOMETRICS=false
VITE_ENABLE_OFFLINE_MODE=true
VITE_MAX_DEVICES=3
"@ | Out-File -FilePath ".env" -Encoding UTF8