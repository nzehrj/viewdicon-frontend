  "cawsRules": [
    {
      "ruleId": "WR-01",
      "ruleText": "Protector does not become predator",
      "severity": "critical",
      "action": "red_shield"
    },
    {
      "ruleId": "WR-02",
      "ruleText": "Do not take coin then disappear",
      "severity": "critical",
      "action": "red_shield"
    },
    {
      "ruleId": "WR-03",
      "ruleText": "Do not threaten the people you guard",
      "severity": "critical",
      "action": "red_shield"
    },
    {
      "ruleId": "WR-04",
      "ruleText": "No stealing from the space you guard",
      "severity": "critical",
      "action": "red_shield"
    },
    {
      "ruleId": "WR-05",
      "ruleText": "You must declare if you are carrying any weapon",
      "severity": "high",
      "action": "amber_shield"
    },
    {
      "ruleId": "WR-06",
      "ruleText": "No force on children",
      "severity": "critical",
      "action": "red_shield"
    },
    {
      "ruleId": "WR-07",
      "ruleText": "Your mouth must cool fire, not start fire",
      "severity": "medium",
      "action": "warn"
    },
    {
      "ruleId": "WR-08",
      "ruleText": "No extortion after duty",
      "severity": "critical",
      "action": "red_shield"
    },
    {
      "ruleId": "WR-09",
      "ruleText": "Respect the body of a woman walking at night",
      "severity": "critical",
      "action": "red_shield"
    },
    {
      "ruleId": "WR-10",
      "ruleText": "If danger is bigger than you, call backup",
      "severity": "high",
      "action": "council_review"
    },
    {
      "ruleId": "WR-11",
      "ruleText": "You are witness, not judge",
      "severity": "high",
      "action": "amber_shield"
    },
    {
      "ruleId": "WR-12",
      "ruleText": "No politics weaponization unless requested",
      "severity": "critical",
      "action": "red_shield"
    },
    {
      "ruleId": "WR-13",
      "ruleText": "Do not lie in your report",
      "severity": "high",
      "action": "delay_payout"
    },
    {
      "ruleId": "WR-14",
      "ruleText": "You must protect those with lower strength",
      "severity": "medium",
      "action": "warn"
    },
    {
      "ruleId": "WR-15",
      "ruleText": "Crowd must go home alive",
      "severity": "critical",
      "action": "red_shield"
    },
    {
      "ruleId": "WR-16",
      "ruleText": "No robbing uniform (no fake police/soldier impersonation)",
      "severity": "critical",
      "action": "red_shield"
    },
    {
      "ruleId": "WR-17",
      "ruleText": "Do not recruit street boys without Council blessing",
      "severity": "high",
      "action": "amber_shield"
    },
    {
      "ruleId": "WR-18",
      "ruleText": "Do not leak address or routine",
      "severity": "critical",
      "action": "red_shield"
    },
    {
      "ruleId": "WR-19",
      "ruleText": "You must answer Council call",
      "severity": "high",
      "action": "amber_shield"
    },
    {
      "ruleId": "WR-20",
      "ruleText": "You are the wall, not the knife",
      "severity": "medium",
      "action": "warn"
    }
