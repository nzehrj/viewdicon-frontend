  "cawsRules": [
    {
      "ruleId": "AMO-01",
      "ruleText": "You do not buy someone's pain. You do not sell someone's shame.",
      "severity": "critical",
      "action": "red_shield"
    },
    {
      "ruleId": "AMO-02",
      "ruleText": "No touching without full clear consent, and minor = never",
      "severity": "critical",
      "action": "red_shield"
    },
    {
      "ruleId": "AMO-03",
      "ruleText": "No sex, nude, or romance in exchange for help, deliverance, or covering",
      "severity": "critical",
      "action": "red_shield"
    },
    {
      "ruleId": "AMO-04",
      "ruleText": "Money is blessing, not ransom (no advance payment demands)",
      "severity": "critical",
      "action": "red_shield"
    },
    {
      "ruleId": "AMO-05",
      "ruleText": "Do not use fear to control",
      "severity": "critical",
      "action": "red_shield"
    },
    {
      "ruleId": "AMO-06",
      "ruleText": "If someone says they are in danger, you must act",
      "severity": "critical",
      "action": "amber_shield"
    },
    {
      "ruleId": "AMO-07",
      "ruleText": "No forced spiritual practice that endangers health",
      "severity": "critical",
      "action": "red_shield"
    },
    {
      "ruleId": "AMO-08",
      "ruleText": "Guard the dignity of widows, orphans, daughters, sons, everyone",
      "severity": "critical",
      "action": "red_shield"
    },
    {
      "ruleId": "AMO-09",
      "ruleText": "No public humiliation in the name of correction",
      "severity": "high",
      "action": "amber_shield"
    },
    {
      "ruleId": "AMO-10",
      "ruleText": "If you offer shelter, you must not trap",
      "severity": "critical",
      "action": "red_shield"
    },
    {
