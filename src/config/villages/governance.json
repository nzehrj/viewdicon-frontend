  "cawsRules": [
    {
      "ruleId": "ALASE-01",
      "ruleText": "If you speak for us, speak with your face (no anonymous leadership)",
      "severity": "critical",
      "action": "red_shield"
    },
    {
      "ruleId": "ALASE-02",
      "ruleText": "A promise spoken to the people is an oath",
      "severity": "high",
      "action": "amber_shield"
    },
    {
      "ruleId": "ALASE-03",
      "ruleText": "Do not eat public yam alone (no stealing community funds)",
      "severity": "critical",
      "action": "red_shield"
    },
    {
      "ruleId": "ALASE-04",
      "ruleText": "Do not send boys to break heads (no violence or thuggery)",
      "severity": "critical",
      "action": "red_shield"
    },
    {
      "ruleId": "ALASE-05",
      "ruleText": "Do not shame the weak for crying",
      "severity": "high",
      "action": "amber_shield"
    },
    {
      "ruleId": "ALASE-06",
      "ruleText": "Do not lie on the land (land fraud causes bloodshed)",
      "severity": "critical",
      "action": "red_shield"
    },
    {
      "ruleId": "ALASE-07",
      "ruleText": "Do not trade freedom for silence (no selling out your people)",
      "severity": "critical",
      "action": "red_shield"
    },
    {
      "ruleId": "ALASE-08",
      "ruleText": "Answer when called (respond to urgent petitions)",
      "severity": "high",
      "action": "amber_shield"
    },
    {
      "ruleId": "ALASE-09",
      "ruleText": "Release the captured (no taking bail money and disappearing)",
      "severity": "critical",
      "action": "red_shield"
    },
    {
      "ruleId": "ALASE-10",
      "ruleText": "No fake observer (election evidence must be real)",
      "severity": "critical",
      "action": "red_shield"
    },
    {
      "ruleId": "ALASE-11",
      "ruleText": "Respect the widow and the orphan",
      "severity": "critical",
      "action": "red_shield"
    },
    {
      "ruleId": "ALASE-12",
      "ruleText": "Community pot is transparent",
      "severity": "high",
      "action": "delay_payout"
    },
    {
      "ruleId": "ALASE-13",
      "ruleText": "Your word does not disappear (no deleting promises)",
      "severity": "high",
      "action": "amber_shield"
    },
    {
      "ruleId": "ALASE-14",
      "ruleText": "Do not endanger whistleblowers",
      "severity": "critical",
      "action": "red_shield"
    },
    {
      "ruleId": "ALASE-15",
      "ruleText": "When fire comes, calm first then speak (no violence incitement)",
      "severity": "critical",
      "action": "red_shield"
    }
  ],
  
  "dashboardLayout": {
    "welcomeMessage": "Bearer of Oath, {petitionsWaiting} petitions wait for your answer. {promisesDue} promises must be delivered this week. The people are watching. Speak with honor.",
