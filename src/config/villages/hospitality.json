  "councilStructure": {
    "hasElders": true,
    "canSuspendMembers": true,
    "canBoostMembers": true,
    "disputeEscalation": "hospitality_council",
    "votingThreshold": 3
  },
  
  "revenueChannels": [
    {
      "type": "paid_service",
      "description": "Bookable hospitality services with escrow protection",
      "enabled": true
    },
    {
      "type": "tipping",
      "description": "Guest appreciation Cowries for excellent service",
      "enabled": true
    },
    {
      "type": "subscription",
      "description": "Regular catering or accommodation contracts",
      "enabled": true
    }
  ],
  
  "specialAIWatch": ["Mother", "Oracle", "Iron", "Thunder"],
  
  "cawsRules": [
    {
      "ruleId": "KARIBU-01",
      "ruleText": "Treat every guest with dignity and respect",
      "severity": "critical",
      "action": "red_shield"
    },
    {
      "ruleId": "KARIBU-02",
      "ruleText": "Food must be clean, safe, and honestly prepared",
      "severity": "critical",
      "action": "red_shield"
    },
    {
      "ruleId": "KARIBU-03",
      "ruleText": "No sexual harassment of guests or co-workers",
      "severity": "critical",
      "action": "red_shield"
    },
    {
      "ruleId": "KARIBU-04",
      "ruleText": "Accommodation spaces must be clean and safe",
      "severity": "critical",
      "action": "red_shield"
    },
    {
      "ruleId": "KARIBU-05",
      "ruleText": "No stealing from guests (money, belongings, identity)",
      "severity": "critical",
      "action": "red_shield"
    },
    {
      "ruleId": "KARIBU-06",
      "ruleText": "Guest privacy and data must be protected",
      "severity": "critical",
      "action": "red_shield"
    },
    {
      "ruleId": "KARIBU-07",
      "ruleText": "Pricing must be transparent (no hidden charges)",
      "severity": "high",
      "action": "amber_shield"
    },
    {
      "ruleId": "KARIBU-08",
      "ruleText": "Bookings and reservations must be honored",
      "severity": "high",
      "action": "amber_shield"
    },
    {
      "ruleId": "KARIBU-09",
      "ruleText": "No fake reviews or paying for false testimonials",
      "severity": "high",
      "action": "amber_shield"
    },
    {
      "ruleId": "KARIBU-10",
      "ruleText": "Cultural and dietary restrictions must be respected",
      "severity": "high",
      "action": "amber_shield"
    },
    {
      "ruleId": "KARIBU-11",
      "ruleText": "Ceremonies must be conducted with cultural sensitivity",
      "severity": "high",
      "action": "amber_shield"
    },
    {
      "ruleId": "KARIBU-12",
      "ruleText": "Tour guides must provide accurate information",
      "severity": "medium",
      "action": "warn"
    },
    {
      "ruleId": "KARIBU-13",
      "ruleText": "No waste of food or resources",
      "severity": "medium",
      "action": "warn"
    },
    {
      "ruleId": "KARIBU-14",
      "ruleText": "Conflicts with guests must be resolved peacefully",
      "severity": "high",
      "action": "amber_shield"
    },
    {
      "ruleId": "KARIBU-15",
      "ruleText": "Emergency safety protocols must be followed",
      "severity": "critical",
      "action": "red_shield"
    }
  ],
  
  "dashboardLayout": {
    "welcomeMessage": "Keeper of Welcome, {bookingsToday} guests await your service. {reviewScore} satisfaction rating. {earningsPending} Cowries to be released. Welcome is your work.",
    "statusTiles": [
      "todays_bookings",
      "guest_satisfaction",
      "services_completed",
      "earnings_pending"
    ],
    "quickActions": [
      "accept_booking",
      "update_menu",
      "check_inventory",
      "respond_to_review",
      "upload_dish_photo"
    ]
  }
