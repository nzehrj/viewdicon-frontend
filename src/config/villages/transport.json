  "cawsRules": [
    {
      "ruleId": "TRANS-01",
      "ruleText": "Safety first always (no reckless driving)",
      "severity": "critical",
      "action": "red_shield"
    },
    {
      "ruleId": "TRANS-02",
      "ruleText": "No sexual harassment of passengers",
      "severity": "critical",
      "action": "red_shield"
    },
    {
      "ruleId": "TRANS-03",
      "ruleText": "No kidnapping or route diversion",
      "severity": "critical",
      "action": "red_shield"
    },
    {
      "ruleId": "TRANS-04",
      "ruleText": "Fares must be agreed upfront (no price extortion)",
      "severity": "high",
      "action": "amber_shield"
    },
    {
      "ruleId": "TRANS-05",
      "ruleText": "Vehicle must be roadworthy (working brakes, lights)",
      "severity": "high",
      "action": "amber_shield"
    },
    {
      "ruleId": "TRANS-06",
      "ruleText": "No overloading passengers beyond capacity",
      "severity": "critical",
      "action": "red_shield"
    },
    {
      "ruleId": "TRANS-07",
      "ruleText": "Follow designated routes and schedules",
      "severity": "medium",
      "action": "warn"
    },
    {
      "ruleId": "TRANS-08",
      "ruleText": "No drunk or drugged driving",
      "severity": "critical",
      "action": "red_shield"
    },
    {
      "ruleId": "TRANS-09",
      "ruleText": "Cargo must be secured properly",
      "severity": "high",
      "action": "amber_shield"
    },
    {
      "ruleId": "TRANS-10",
      "ruleText": "No transporting illegal goods or contraband",
      "severity": "critical",
      "action": "red_shield"
    },
    {
      "ruleId": "TRANS-11",
      "ruleText": "Rest breaks required for long-distance drivers",
      "severity": "high",
      "action": "amber_shield"
    },
    {
      "ruleId": "TRANS-12",
      "ruleText": "Packages must be handled with care",
      "severity": "medium",
      "action": "warn"
    },
    {
      "ruleId": "TRANS-13",
      "ruleText": "No opening customer packages",
      "severity": "critical",
      "action": "red_shield"
    },
    {
      "ruleId": "TRANS-14",
      "ruleText": "Dispatch must communicate delays honestly",
      "severity": "medium",
      "action": "warn"
    },
    {
      "ruleId": "TRANS-15",
      "ruleText": "Fleet maintenance records must be accurate",
      "severity": "high",
      "action": "amber_shield"
    },
    {
      "ruleId": "TRANS-16",
      "ruleText": "Life jackets must be provided to all passengers",
      "severity": "critical",
      "action": "red_shield"
    },
    {
      "ruleId": "TRANS-17",
      "ruleText": "No sailing in dangerous weather conditions",
      "severity": "critical",
      "action": "red_shield"
    },
    {
      "ruleId": "TRANS-18",
