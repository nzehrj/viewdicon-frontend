  "cawsRules": [
    {
      "ruleId": "FIN-01",
      "ruleText": "You do not steal money (no embezzlement, no missing funds)",
      "severity": "critical",
      "action": "red_shield"
    },
    {
      "ruleId": "FIN-02",
      "ruleText": "You do not cook the books (no false records)",
      "severity": "critical",
      "action": "red_shield"
    },
    {
      "ruleId": "FIN-03",
      "ruleText": "You must balance accounts honestly",
      "severity": "high",
      "action": "amber_shield"
    },
    {
      "ruleId": "FIN-04",
      "ruleText": "No insider theft or fraud",
      "severity": "critical",
      "action": "red_shield"
    },
    {
      "ruleId": "FIN-05",
      "ruleText": "Cash drawer shortages must be explained",
      "severity": "high",
      "action": "amber_shield"
    },
    {
      "ruleId": "FIN-06",
      "ruleText": "Tax calculations must be accurate",
      "severity": "high",
      "action": "amber_shield"
    },
    {
      "ruleId": "FIN-07",
      "ruleText": "No helping customers commit fraud",
      "severity": "critical",
      "action": "red_shield"
    },
    {
      "ruleId": "FIN-08",
      "ruleText": "No fake insurance policies",
      "severity": "critical",
      "action": "red_shield"
    },
    {
      "ruleId": "FIN-09",
      "ruleText": "Honor legitimate claims (no denying valid insurance claims)",
      "severity": "high",
      "action": "amber_shield"
    },
    {
      "ruleId": "FIN-10",
      "ruleText": "Premiums must be explained clearly",
      "severity": "medium",
      "action": "warn"
    },
    {
      "ruleId": "FIN-11",
      "ruleText": "No Ponzi schemes or pyramid schemes",
      "severity": "critical",
      "action": "red_shield"
    },
    {
      "ruleId": "FIN-12",
      "ruleText": "Investment advice must be honest, not guaranteed riches",
      "severity": "high",
      "action": "amber_shield"
    },
    {
      "ruleId": "FIN-13",
      "ruleText": "Disclose conflicts of interest",
      "severity": "high",
      "action": "amber_shield"
    },
    {
      "ruleId": "FIN-14",
      "ruleText": "No predatory lending (interest rates must be fair)",
      "severity": "critical",
      "action": "red_shield"
    },
    {
      "ruleId": "FIN-15",
      "ruleText": "Loan terms must be explained clearly before signing",
      "severity": "high",
      "action": "amber_shield"
    }
  ],
  
